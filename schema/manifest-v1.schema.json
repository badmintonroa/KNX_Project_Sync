{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/badmintonroa/Knx-has-auto-importer/schema/manifest-v1.schema.json",
  "title": "knx2home-ha-manifest v1",
  "description": "Home Assistant KNX entities derived from one ETS project, with stable keys for updates. See docs/manifest-v1.md.",
  "type": "object",
  "required": ["format", "version", "generator", "project", "options", "entities", "unmapped"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "knx2home-ha-manifest" },
    "version": { "const": 1 },
    "generator": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "commit": { "type": ["string", "null"] }
      }
    },
    "project": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": ["string", "null"] }
      }
    },
    "options": {
      "type": "object",
      "required": ["drop_reserve"],
      "properties": {
        "drop_reserve": { "type": "boolean" }
      }
    },
    "entities": {
      "type": "array",
      "items": { "$ref": "#/$defs/entity" }
    },
    "unmapped": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["address", "ga_id", "name", "dpt"],
        "additionalProperties": false,
        "properties": {
          "address": { "$ref": "#/$defs/address" },
          "ga_id": { "$ref": "#/$defs/gaId" },
          "name": { "type": ["string", "null"] },
          "dpt": { "type": ["string", "null"] }
        }
      }
    }
  },
  "$defs": {
    "address": {
      "type": "string",
      "pattern": "^\\d+(/\\d+){0,2}$"
    },
    "gaId": {
      "type": ["string", "null"],
      "pattern": "^GA-\\d+$"
    },
    "domain": {
      "enum": ["switch", "binary_sensor", "light", "sensor", "time", "date", "datetime", "cover", "scene", "climate", "weather"]
    },
    "entity": {
      "type": "object",
      "required": ["key", "domain", "name", "config", "sources"],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z_]+:(GA-\\d+|addr:[0-9/]+|addr:none)(#\\d+)?$"
        },
        "domain": { "$ref": "#/$defs/domain" },
        "name": { "type": ["string", "null"] },
        "config": {
          "description": "Entry for the `knx:` YAML of Home Assistant, exactly as knx2home exports it.",
          "type": "object",
          "minProperties": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["field", "address", "ga_id"],
            "additionalProperties": false,
            "properties": {
              "field": { "type": "string" },
              "address": { "$ref": "#/$defs/address" },
              "ga_id": { "$ref": "#/$defs/gaId" }
            }
          }
        }
      }
    }
  }
}
